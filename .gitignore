# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data: raw PDFs are not redistributed; only the provenance file is tracked
data/raw/*
!data/raw/SOURCES.csv
data/processed/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# CI HuggingFace cache
.hf-cache/

# Secrets (LLM_API_KEY is read from the environment only)
.env
.env.*
*.key
*.pem

# Regenerable retrieval outputs
results/retrieval/
results/smoke/
# Regenerable generation outputs (per-question records; the LLM cache makes reruns cheap)
results/generation/

# Local UI feedback (stays on this machine)
data/feedback.jsonl

# Further collections (collections/<name>/): PDFs are not redistributed (SOURCES.csv records
# their provenance and licence); processed data and per-question outputs are regenerable;
# the evaluation set, result tables, the test-access log and the pipeline log are tracked.
collections/*/raw/*
!collections/*/raw/SOURCES.csv
!collections/*/raw/SOURCES_app.csv
collections/*/processed/
collections/*/results/retrieval/
collections/*/results/generation/
collections/*/results/smoke/
collections/*/results/pipeline_state.json
collections/*/feedback.jsonl
results/pipeline_state.json

# app indexes (scripts/run_app_collections.py): state file and processed data are regenerable
collections/app_pipeline_state.json
collections/*/processed_app/
